      <bpmndi:BPMNShape id="Gateway_XrayJoin_di" bpmnElement="Gateway_XrayJoin" isMarkerVisible="true">
        <dc:Bounds x="625" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TestsJoin_di" bpmnElement="Gateway_TestsJoin" isMarkerVisible="true">
        <dc:Bounds x="720" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SecondConsult_di" bpmnElement="Task_SecondConsult">
        <dc:Bounds x="810" y="148" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TreatmentSplit_di" bpmnElement="Gateway_TreatmentSplit" isMarkerVisible="true">
        <dc:Bounds x="970" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Surgery_di" bpmnElement="Task_Surgery">
        <dc:Bounds x="1060" y="85" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Medicine_di" bpmnElement="Task_Medicine">
        <dc:Bounds x="1060" y="225" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TreatmentJoin_di" bpmnElement="Gateway_TreatmentJoin" isMarkerVisible="true">
        <dc:Bounds x="1200" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FinalConsult_di" bpmnElement="Task_FinalConsult">
        <dc:Bounds x="1290" y="148" width="115" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1445" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="76" y="178" />
        <di:waypoint x="110" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
