<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PatientTreatment" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_PatientTreatment_POWL" name="Patient Treatment POWL" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_FirstConsult" name="First consult" />
    <bpmn:parallelGateway id="Gateway_TestsSplit" />
    <bpmn:task id="Task_PhysicalTest" name="Physical test" />
    <bpmn:task id="Task_BloodTest" name="Blood test" />
    <bpmn:exclusiveGateway id="Gateway_XraySplit" default="Flow_07" />
    <bpmn:task id="Task_XrayScan" name="X-ray scan" />
    <bpmn:exclusiveGateway id="Gateway_XrayJoin" />
    <bpmn:parallelGateway id="Gateway_TestsJoin" />
    <bpmn:task id="Task_SecondConsult" name="Second consult" />
    <bpmn:exclusiveGateway id="Gateway_TreatmentSplit" default="Flow_15" />
    <bpmn:task id="Task_Surgery" name="Surgery" />
    <bpmn:task id="Task_Medicine" name="Medicine" />
    <bpmn:exclusiveGateway id="Gateway_TreatmentJoin" />
    <bpmn:task id="Task_FinalConsult" name="Final consult" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_FirstConsult" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_FirstConsult" targetRef="Gateway_TestsSplit" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_TestsSplit" targetRef="Task_PhysicalTest" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_TestsSplit" targetRef="Task_BloodTest" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_TestsSplit" targetRef="Gateway_XraySplit" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_XraySplit" targetRef="Task_XrayScan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable("needsXray") and needsXray == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_XraySplit" targetRef="Gateway_XrayJoin" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_XrayScan" targetRef="Gateway_XrayJoin" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_PhysicalTest" targetRef="Gateway_TestsJoin" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_BloodTest" targetRef="Gateway_TestsJoin" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_XrayJoin" targetRef="Gateway_TestsJoin" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_TestsJoin" targetRef="Task_SecondConsult" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SecondConsult" targetRef="Gateway_TreatmentSplit" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_TreatmentSplit" targetRef="Task_Surgery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable("treatment") and treatment == "surgery"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_TreatmentSplit" targetRef="Task_Medicine" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Surgery" targetRef="Gateway_TreatmentJoin" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Medicine" targetRef="Gateway_TreatmentJoin" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_TreatmentJoin" targetRef="Task_FinalConsult" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_FinalConsult" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PatientTreatment">
    <bpmndi:BPMNPlane id="BPMNPlane_PatientTreatment" bpmnElement="Process_PatientTreatment_POWL">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="40" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FirstConsult_di" bpmnElement="Task_FirstConsult">
        <dc:Bounds x="110" y="148" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TestsSplit_di" bpmnElement="Gateway_TestsSplit" isMarkerVisible="true">
        <dc:Bounds x="260" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PhysicalTest_di" bpmnElement="Task_PhysicalTest">
        <dc:Bounds x="350" y="75" width="115" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BloodTest_di" bpmnElement="Task_BloodTest">
